{
  "version": 1,
  "recipe": "godot-addon",
  "repository": "aviorstudio/gd-clerk",
  "tools": {
    "node": "22.20.0",
    "github:aviorstudio/gdam": {
      "version": "v0.1.5",
      "asset_pattern": "gdam_Linux_x86_64.tar.gz",
      "bin": "gdam"
    }
  },
  "stages": {
    "install": [
      [
        "python3",
        "-c",
        "import os,runpy;runpy.run_path(os.environ[\"CICD_ENGINEERING\"]+\"/helpers/godot-addon.py\",run_name=\"__main__\")",
        "install"
      ],
      [
        "npm",
        "ci"
      ],
      [
        "bash",
        "scripts/install.sh"
      ]
    ],
    "lint": [
      [
        "npm",
        "audit",
        "--audit-level=high"
      ],
      [
        "node",
        "scripts/vendor-clerk.mjs",
        "--check"
      ],
      [
        "node",
        "scripts/scan.mjs"
      ],
      [
        "node",
        "scripts/workflow-policy.mjs"
      ]
    ],
    "unit": [
      [
        "bash",
        "scripts/test-env.sh",
        "npm",
        "test"
      ],
      [
        "bash",
        "scripts/test-env.sh",
        "bash",
        "scripts/run-godot-tests.sh"
      ],
      [
        "bash",
        "scripts/test-env.sh",
        "npm",
        "run",
        "test:browser"
      ],
      [
        "bash",
        "scripts/test-env.sh",
        "node",
        "--test",
        "tests/web/origin_export.test.mjs"
      ],
      [
        "bash",
        "scripts/test-env.sh",
        "node",
        "--test",
        "tests/web/configure_export.test.mjs"
      ],
      [
        "bash",
        "scripts/test-env.sh",
        "node",
        "--test",
        "tests/web/revoke_export.test.mjs"
      ]
    ],
    "build": [
      [
        "node",
        "scripts/package-addon.mjs"
      ],
      [
        "node",
        "scripts/verify-zip.mjs",
        "dist/@aviorstudio_gd-clerk.zip"
      ]
    ],
    "artifact-check": [
      [
        "bash",
        "scripts/test-env.sh",
        "node",
        "scripts/editor-lifecycle.mjs",
        "dist/@aviorstudio_gd-clerk.zip"
      ]
    ],
    "clean": [
      [
        "python3",
        "-c",
        "import shutil; [shutil.rmtree(p, ignore_errors=True) for p in (\".artifacts\", \"dist\", \"node_modules\", \".godot\")]"
      ]
    ]
  },
  "validation": {
    "workflow": {
      "required": [
        "ci.yml",
        "dependency-policy.yml",
        "release.yml"
      ],
      "ci_gates": [
        "Test"
      ]
    }
  }
}
